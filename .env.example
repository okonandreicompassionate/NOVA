# Same Supabase project as the web plugin — the brain never uses a service-role
# key, only the caller's own JWT (forwarded per-request), so RLS still applies.
SUPABASE_URL=
SUPABASE_ANON_KEY=

AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Shared secret the Web plugin (Next.js) must send so the brain only accepts
# requests proxied through it, not arbitrary direct callers.
BRAIN_PLUGIN_SECRET=

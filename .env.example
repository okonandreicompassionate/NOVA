# Same Supabase project as the web plugin — the brain never uses a service-role
# key, only the caller's own JWT (forwarded per-request), so RLS still applies.
SUPABASE_URL=
SUPABASE_ANON_KEY=

AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# NOVA's voice — Groq-hosted neural TTS (Orpheus). Requires accepting the
# model's terms once at https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
# Voice options: tara, leah, jess, leo, dan, mia, zac, zoe
SPEECH_VOICE=tara

# Shared secret the Web plugin (Next.js) must send so the brain only accepts
# requests proxied through it, not arbitrary direct callers.
BRAIN_PLUGIN_SECRET=

# Comma-separated origins allowed to call this API (CORS). Include your Vercel
# deployment URL once nova-web is live, e.g.:
# http://localhost:3000,https://nova-web.vercel.app
WEB_ORIGINS=http://localhost:3000
